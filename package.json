{
  "name": "steam-login-lite",
  "version": "2.1.3",
  "private": true,
  "description": "Steam account manager",
  "author": "Steam Login Lite",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test desktop/*.test.cjs",
    "build:helper": "dotnet build helper/SteamLoginBridge.csproj -c Release",
    "pack:win": "npm run build && npm run build:helper && electron-builder --win zip --x64",
    "test:query": "electron scripts/verify-query.cjs",
    "test:ui": "electron scripts/verify-ui.cjs",
    "test:preferences": "dotnet run --project tests/SteamPreferences/SteamPreferences.csproj"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.steamloginlite.desktop",
    "productName": "SteamLoginLite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "Assets/SteamSwitcher.png",
      "!desktop/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "helper/bin/Release/net48",
        "to": "bridge",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      },
      {
        "from": "使用说明.txt",
        "to": "使用说明.txt"
      }
    ],
    "win": {
      "target": "zip",
      "icon": "Assets/SteamSwitcher.ico",
      "signExecutable": false
    },
    "artifactName": "SteamLoginLite-${version}-win-${arch}.zip"
  }
}
