<Window x:Class="SteamLoginLite.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账号" Icon="/Assets/SteamSwitcher.png" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent" FontFamily="Microsoft YaHei UI">
    <Border Background="#F7F9FC" CornerRadius="14" BorderBrush="#DDE4EF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#14223A" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="74" /></Grid.RowDefinitions>
            <Border Background="White" CornerRadius="14,14,0,0" BorderBrush="#E2E8F1" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,12,0"><TextBlock Text="编辑账号" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" /><Button Content="×" Width="38" Height="38" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#526178" Cursor="Hand" Click="Cancel_Click" /></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,22"><Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="62" /><RowDefinition Height="62" /><RowDefinition Height="62" /><RowDefinition Height="62" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                    <TextBlock Text="Steam 账号" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource RoundedTextBox}" />
                    <TextBlock Grid.Row="1" Text="Steam 密码" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="10" Padding="13,0"><PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" ToolTip="留空表示不修改原密码" /></Border>
                    <TextBlock Grid.Row="2" Text="邮箱" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="EmailBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedTextBox}" />
                    <TextBlock Grid.Row="3" Text="邮箱密码" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Grid.Row="3" Grid.Column="1" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="10" Padding="13,0"><PasswordBox x:Name="EmailPasswordBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" ToolTip="留空表示不修改原密码" /></Border>
                    <TextBlock Grid.Row="4" Text="PUBG 查询 ID" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="GameIdBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedTextBox}" />
                    <TextBlock Grid.Row="5" Text="备注" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="NoteBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedTextBox}" />
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,14,14" BorderBrush="#E2E8F1" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"><Button Style="{StaticResource SecondaryButton}" Content="取消" Width="96" Click="Cancel_Click" /><Button Style="{StaticResource PrimaryButton}" Content="保存" Width="104" Margin="10,0,0,0" Click="Save_Click" /></StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
