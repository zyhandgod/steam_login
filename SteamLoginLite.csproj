<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SteamSwitcher.ico</ApplicationIcon>
    <AssemblyName>SteamLoginLite</AssemblyName>
    <RootNamespace>SteamLoginLite</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;Program.cs;MainForm.cs;AccountEditDialog.cs;UiStyle.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets/SteamSwitcher.png" />
    <Resource Include="Assets/SteamSwitcher.png" />
    <None Remove="Assets/SteamSwitcherSidebar.png" />
    <Resource Include="Assets/SteamSwitcherSidebar.png" />
  </ItemGroup>
  <Target Name="CopyX64WebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes/win-x64/native/WebView2Loader.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(OutputPath)runtimes/win-x64/native/WebView2Loader.dll')" />
  </Target>
</Project>
