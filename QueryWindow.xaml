<Window
    x:Class="SteamLoginLite.QueryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PUBG.PLUS 等级与封禁查询">
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="查询 ID 已自动填写，请在网页中点击“查询”；返回结果后会自动保存并进入下一项。" Foreground="#718096" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
