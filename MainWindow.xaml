<Window
    x:Class="SteamLoginLite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamLoginLite"
    xmlns:models="using:SteamLoginLite.Models"
    Title="Steam切换器">
    <Grid Background="#F7F9FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111C31">
            <Grid Padding="12,18,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Width="44" Height="44" Source="Assets/SteamSwitcher.png" Stretch="Uniform" />
                <Button x:Name="AccountsNav" Grid.Row="1" Width="52" Height="52" Padding="0" Margin="0,8,0,4" Style="{StaticResource PrimaryButtonStyle}" Click="AccountsNav_Click" ToolTipService.ToolTip="账号管理">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" />
                </Button>
                <Button x:Name="ImportNav" Grid.Row="2" Width="52" Height="52" Padding="0" Margin="0,4" Background="Transparent" Foreground="#B8C4D8" BorderThickness="0" Click="ImportNav_Click" ToolTipService.ToolTip="批量导入">
                    <FontIcon Glyph="&#xE896;" FontSize="20" />
                </Button>
                <Button x:Name="SettingsNav" Grid.Row="3" Width="52" Height="52" Padding="0" Margin="0,4" Background="Transparent" Foreground="#B8C4D8" BorderThickness="0" Click="SettingsNav_Click" ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="20" />
                </Button>
                <Ellipse Grid.Row="5" Width="7" Height="7" Fill="#19B879" ToolTipService.ToolTip="本机安全存储，升级自动保留数据" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="AccountsPage" Padding="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" Height="36" PlaceholderText="搜索账号或查询 ID" TextChanged="SearchBox_TextChanged" QueryIcon="Find" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="8,0,0,16">
                        <TextBlock><Run Text="全部 "/><Run x:Name="TotalCount" Text="0" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Foreground="#0F9D69"><Run Text="正常 "/><Run x:Name="NormalCount" Text="0" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Foreground="#DC3545"><Run Text="临时 "/><Run x:Name="TempCount" Text="0" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Foreground="#DC3545"><Run Text="永久 "/><Run x:Name="PermanentCount" Text="0" FontWeight="SemiBold" /></TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="批量查询" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Top" Click="BatchQuery_Click" />
                    <Button Grid.Column="3" Content="批量删除" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Click="BatchDelete_Click" />
                </Grid>

                <Border Grid.Row="1" Background="#F1F4F8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1" Padding="12,0">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="56"/><ColumnDefinition Width="90"/><ColumnDefinition Width="118"/><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选择" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="账号" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="查询 ID" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="等级" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="封禁状态" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="最后登录" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="最后查询" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="备注" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="8" Text="操作" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListView x:Name="AccountsList" Grid.Row="2" SelectionMode="None" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="54" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AccountRecord">
                            <Border Background="{Binding UiIsCurrent, Converter={StaticResource CurrentRowBackground}}" BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="12,0" MinHeight="54">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="56"/><ColumnDefinition Width="90"/><ColumnDefinition Width="118"/><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding UiSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="#E7EEFF" CornerRadius="4" Padding="5,2" Visibility="{Binding UiIsCurrent, Converter={StaticResource BoolVisibility}}"><TextBlock Text="当前" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /></Border>
                                        <TextBlock Text="{Binding Username}" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding EffectiveGameId}" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding LevelText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Background="{Binding Status, Converter={StaticResource StatusBackground}}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusForeground}}" FontSize="11" FontWeight="SemiBold" /></Border>
                                    <TextBlock Grid.Column="5" Text="{Binding LastLoginText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="6" Text="{Binding LastQueryText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="{Binding Note}" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="登录" Tag="{Binding}" Style="{StaticResource RowPrimaryButtonStyle}" Click="Login_Click" />
                                        <Button Content="查询" Tag="{Binding}" Style="{StaticResource RowButtonStyle}" Click="Query_Click" />
                                        <Button Content="编辑" Tag="{Binding}" Style="{StaticResource RowButtonStyle}" Click="Edit_Click" />
                                        <Button Content="删除" Tag="{Binding}" Style="{StaticResource RowDangerButtonStyle}" Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="ImportPage" Visibility="Collapsed" Padding="24,20,24,22" ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="粘贴账号数据" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="每行一个账号，支持中文标签或 -- / --- / ---- 分隔" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                    <TextBox x:Name="ImportText" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap" PlaceholderText="fxols54967--sltm34244M&#x0a;账号fxols54967密码sltm34244M" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="清空内容" Style="{StaticResource SecondaryButtonStyle}" Click="ClearImport_Click"/><Button Content="解析预览" Style="{StaticResource PrimaryButtonStyle}" Click="ParseImport_Click"/></StackPanel>
                </Grid>
                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="解析预览" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PreviewCount" Text="共 0 条　可导入 0 条" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
                    <ListView x:Name="PreviewList" Grid.Row="1" SelectionMode="None" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="10,7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LineNumber}"/><TextBlock Grid.Column="1" Text="{Binding Username}"/><TextBlock Grid.Column="2" Text="{Binding Email}"/><TextBlock Grid.Column="3" Text="{Binding GameId}"/><TextBlock Grid.Column="4" Text="{Binding Error}"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Content="导入有效账号" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="CommitImport_Click" />
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed" Padding="36,30" MaxWidth="900" HorizontalAlignment="Left" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Steam 路径" VerticalAlignment="Center"/><TextBox x:Name="SteamPathBox" Grid.Column="1"/><Button Grid.Column="2" Content="选择文件" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseSteam_Click"/></Grid>
                <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="启动等待（秒）" VerticalAlignment="Center"/><NumberBox x:Name="StartupDelayBox" Grid.Column="1" Minimum="2" Maximum="30" SpinButtonPlacementMode="Inline"/></Grid>
                <StackPanel Grid.Row="3" Spacing="8"><CheckBox x:Name="CloseRecommendationsBox" Content="自动关闭推荐/新闻窗口"/><CheckBox x:Name="CloseFriendsBox" Content="自动关闭好友列表"/><CheckBox x:Name="OpenLibraryBox" Content="登录后自动打开游戏库"/></StackPanel>
                <TextBlock Grid.Row="4" Text="登录时会完全退出旧 Steam，再通过 steam.exe -login 启动。Steam Guard 与验证码仍由 Steam 官方窗口处理。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <Button Grid.Row="5" Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
